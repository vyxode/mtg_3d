# Copia este archivo a .env y cambia la contraseña. .env nunca se sube al repositorio.
POSTGRES_USER=mtg3d
POSTGRES_PASSWORD=cambia-esta-contraseña
POSTGRES_DB=mtg3d
POSTGRES_PORT=5432

# Servidor: con DATABASE_URL las salas y partidas sobreviven a un reinicio (sin ella viven solo en memoria).
DATABASE_URL=postgres://mtg3d:cambia-esta-contraseña@localhost:5432/mtg3d
