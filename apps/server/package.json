{
  "name": "@mtg3d/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "cards:sync": "tsx src/sync-cards.ts",
    "cards:es": "tsx src/es-cards.ts",
    "cards:oracle": "tsx src/oracle-cards.ts"
  },
  "dependencies": {
    "@mtg3d/cards": "workspace:*",
