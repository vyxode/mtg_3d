    "@mtg3d/protocol": "workspace:*",
    "@mtg3d/rooms": "workspace:*",
    "pg": "8.23.1",
    "socket.io": "^4.8.4",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/pg": "8.23.1",
    "socket.io-client": "^4.8.4"
