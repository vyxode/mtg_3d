{
  "name": "mtg3d",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @mtg3d/server --filter @mtg3d/web dev",
    "build": "pnpm --filter @mtg3d/web build",
    "start": "pnpm --filter @mtg3d/server start",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:up": "docker compose -f infra/docker-compose.yml --env-file .env up -d",
    "db:down": "docker compose -f infra/docker-compose.yml --env-file .env down",
    "cards:sync": "pnpm --filter @mtg3d/server cards:sync",
    "cards:es": "pnpm --filter @mtg3d/server cards:es",
    "cards:oracle": "pnpm --filter @mtg3d/server cards:oracle"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "eslint": "^10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
